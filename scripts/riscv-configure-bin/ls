#!/bin/sh
# glibc's configure uses `ls -d` to enumerate sysdeps preconfigure files.
# Keep that enumeration independent of host ls implementations that limit the
# number of path operands they print.
if [ "$1" = "-d" ]; then
  shift
  status=0
  for path do
    if [ -e "$path" ] || [ -L "$path" ]; then
      printf '%s\n' "$path"
    else
      /bin/ls -d -- "$path" || status=$?
    fi
  done
  exit "$status"
fi

exec /bin/ls "$@"
